{
  "$schema": "./node_modules/@stryker-mutator/core/schema/stryker-schema.json",
  "_comment": "Mutationstest av de rena funktionerna (audit-kolumnen Mutation). Kör: npm i --no-save @stryker-mutator/core@9 && npx stryker run. UI-delen av app.js (från rad 1036) muteras inte.",
  "testRunner": "command",
  "commandRunner": { "command": "SIPDECK_APP_SOURCE=../../app.js npm test" },
  "coverageAnalysis": "off",
  "mutate": ["app.js:276-1018", "worker/drink-rules.js"],
  "ignorePatterns": ["img-src", "playwright-report", "test-results", "reports"],
  "reporters": ["clear-text", "progress", "html", "json"],
  "htmlReporter": { "fileName": "reports/mutation/mutation.html" },
  "jsonReporter": { "fileName": "reports/mutation/mutation.json" },
  "concurrency": 4,
  "timeoutMS": 10000
}
